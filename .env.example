# SoroProbe configuration.
#
# Every setting has a working default aimed at the public testnet, so this file
# is entirely optional.
#
# SoroProbe does not read .env itself; it reads the environment. Load this file
# into your shell or hand it to Docker:
#
#   set -a && . ./.env && set +a      # export everything into the shell
#   docker run --env-file .env soroprobe check <contract>
#
# For a file SoroProbe does read directly, use a JSON config file instead
# (SOROPROBE_CONFIG or --config; see the README).
#
# Precedence, lowest to highest: defaults, config file, environment, CLI flags.

# Stellar RPC endpoint.
#   testnet: https://soroban-testnet.stellar.org
#   mainnet: supply your own provider's URL
RPC_URL=https://soroban-testnet.stellar.org

# Network passphrase. Must match the network RPC_URL points at.
#   testnet: Test SDF Network ; September 2015
#   mainnet: Public Global Stellar Network ; September 2015
NETWORK_PASSPHRASE=Test SDF Network ; September 2015

# Public key used as the transaction source when building a call to simulate.
#
# This is a PUBLIC key and nothing else. SoroProbe never signs and never
# submits, so a secret key is never required and must never be put here. The
# account does not need to exist or hold a balance; the default below is an
# all-zero placeholder.
#
# Set this to a real account only when a contract authorizes on the invoker's
# address and you want the simulation to reflect that.
SOURCE_ACCOUNT=GAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAWHF

# Listen address for the HTTP API (`soroprobe serve`).
#
# Defaults to 127.0.0.1:8080, so a fresh checkout serves the local machine only.
# SoroProbe is read-only, but an instance reachable from the network still
# spends the operator's RPC quota on whoever finds it, so serving wider than
# the loopback interface is an opt-in. Widen it when you mean to serve others:
#
# HTTP_ADDR=0.0.0.0:8080
HTTP_ADDR=127.0.0.1:8080

# Logging verbosity: debug, info, warn or error.
LOG_LEVEL=info

# Timeout applied to each RPC request.
RPC_TIMEOUT=30s

# How long `soroprobe serve` may reuse an inspect result for the same contract
# and key set. Off by default: a cached answer can lag a ledger boundary, so
# opt in only when dashboards poll the same contracts. TTLs change at most once
# per ledger (about five seconds), so a few seconds is a sensible window.
INSPECT_CACHE_TTL=0s

# State-expiration thresholds, in ledgers remaining. At the network's five
# second target close time, 17280 ledgers is about a day.
#   120960 ledgers ~ 7 days
#    17280 ledgers ~ 1 day
WARN_LEDGERS=120960
CRITICAL_LEDGERS=17280

# Optional per-kind overrides. Omitted values inherit the corresponding global
# threshold above.
# INSTANCE_WARN_LEDGERS=120960
# INSTANCE_CRITICAL_LEDGERS=17280
# CODE_WARN_LEDGERS=120960
# CODE_CRITICAL_LEDGERS=17280
# DATA_WARN_LEDGERS=120960
# DATA_CRITICAL_LEDGERS=17280

# Optional SoroVault registry. When set, simulate arguments without a type
# prefix are typed from the contract's recorded interface instead of guessed.
# SOROVAULT_URL=http://localhost:8080

# Optional path to a JSON or YAML config file. Without this, ./soroprobe.json,
# ./soroprobe.yaml, or ./soroprobe.yml is used when present.
# SOROPROBE_CONFIG=./soroprobe.json

# Optional configuration profile to load from the config file.
# SOROPROBE_PROFILE=mainnet
